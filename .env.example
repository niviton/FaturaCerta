# --- Django ---
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco. Sem DATABASE_URL o sistema usa SQLite local (apenas para desenvolvimento rápido).
DATABASE_URL=postgres://faturacerta:faturacerta@postgres:5432/faturacerta

# Celery / Redis. Sem REDIS_URL as tarefas rodam de forma síncrona (CELERY_TASK_ALWAYS_EAGER).
REDIS_URL=redis://redis:6379/0

# Chave Fernet para criptografar credenciais e tokens no banco.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Integrações (vazio = implementação Fake) ---
# Provedor padrão de inversor: fake|growatt|huawei|solaredge|fronius|goodwe|deye
INVERTER_PROVIDER=fake
METER_PROVIDER=fake
# IA para leitura de fatura e assistente
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Gmail (OAuth2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Notificações
NOTIFY_EMAIL_PROVIDER=fake
NOTIFY_WHATSAPP_PROVIDER=fake
