# --- Django ---
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Com DJANGO_DEBUG=0, redireciona para HTTPS (desligue só atrás de proxy que já faz isso)
DJANGO_SSL_REDIRECT=1

# Banco. Sem DATABASE_URL o sistema usa SQLite local (apenas para desenvolvimento rápido).
DATABASE_URL=postgres://faturacerta:faturacerta@postgres:5432/faturacerta

# Celery / Redis. Sem REDIS_URL as tarefas rodam de forma síncrona (CELERY_TASK_ALWAYS_EAGER).
REDIS_URL=redis://redis:6379/0

# Chave Fernet para criptografar credenciais e tokens no banco. OBRIGATÓRIA em produção.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar a chave torna ilegíveis as credenciais já salvas.
FIELD_ENCRYPTION_KEY=

# --- Monitoramento ---
# Horas sem leitura para a usina ficar "sem comunicação"
MONITOR_HORAS_SEM_COMUNICACAO=3
# Fração do esperado (últimos 7 dias) abaixo da qual a usina fica "abaixo do esperado"
MONITOR_LIMIAR_ABAIXO=0.8

# --- Integrações (vazio = implementação fictícia) ---
# Provedor padrão de inversor quando o cadastro não indica: fake|growatt|huawei|solaredge|fronius|goodwe|deye
INVERTER_PROVIDER=fake
METER_PROVIDER=fake
# IA para leitura de fatura e assistente (fases seguintes)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Gmail (OAuth2, fase seguinte)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Notificações ---
# E-mail: fake (só registra no log) | smtp (usa o backend abaixo)
NOTIFY_EMAIL_PROVIDER=fake
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FaturaCerta <nao-responda@faturacerta.local>
# WhatsApp: fake | cloud (WhatsApp Business Cloud API da Meta)
NOTIFY_WHATSAPP_PROVIDER=fake
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=alerta_usina
